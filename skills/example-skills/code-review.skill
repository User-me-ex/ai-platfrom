{
  "definition": {
    "id": "example-code-review",
    "name": "Code Reviewer",
    "version": "1.0.0",
    "description": "Reviews code for bugs, style issues, and security vulnerabilities",
    "category": "processor",
    "entry": "skills/example-skills/code-review.skill",
    "dependencies": ["chat", "commands"],
    "requiredCapabilities": [
      {
        "type": "command",
        "name": "review",
        "description": "A /review command to analyze code",
        "priority": "optional"
      }
    ],
    "hooks": ["onChatStart"],
    "config": {
      "strictness": "moderate",
      "checkSecurity": true,
      "checkStyle": true
    }
  },
  "pattern": {
    "id": "review",
    "name": "CodeReview",
    "trigger": "review",
    "response": "Running code review...",
    "confidence": 0.85,
    "usageCount": 0,
    "successRate": 1.0,
    "createdAt": 1749562200000,
    "lastUsed": 1749562200000
  },
  "examples": [
    {
      "user": "review this code for bugs",
      "assistant": "Code review results:\n\n✅ No syntax errors found\n⚠ Warning: Unused variable 'result' on line 42\n⚠ Warning: Missing error handling in try/catch block\nℹ Suggestion: Use const instead of let for immutable bindings",
      "tools": ["chat", "lint"],
      "success": true
    }
  ]
}
