#!/usr/bin/env bash
# 9 Router CLI — Bash launcher
# Works from any terminal (bash, zsh, etc.) on any directory
#
# Usage:
#   9cli                  Start interactive mode
#   9cli "your message"   Single-shot query
#   9cli --help           Show help
#   9cli --version        Show version

PROJECT_DIR="D:/9router cli"

# Try to find bun
BUN=""
if command -v bun.exe &>/dev/null; then
    BUN="bun.exe"
elif command -v bun &>/dev/null; then
    BUN="bun"
elif [ -f "/c/Users/USER/AppData/Local/Kiro-Cli/bun" ]; then
    BUN="/c/Users/USER/AppData/Local/Kiro-Cli/bun"
elif [ -f "$HOME/.bun/bin/bun" ]; then
    BUN="$HOME/.bun/bin/bun"
fi

if [ -z "$BUN" ]; then
    echo "Error: bun not found. Install bun from https://bun.sh"
    exit 1
fi

exec "$BUN" "$PROJECT_DIR/src/index.ts" "$@"
